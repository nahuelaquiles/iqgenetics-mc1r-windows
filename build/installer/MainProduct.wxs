<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="IQ Genetics MC1R Haplotype Analysis"
    Manufacturer="IQ Genetics / GECORP"
    Version="1.0.0.0"
    UpgradeCode="224D0170-2C49-4659-9B9A-7DB949722806"
    Language="1033"
    Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of IQ Genetics MC1R Haplotype Analysis is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="MainFeature" Title="IQ Genetics MC1R Haplotype Analysis" Level="1">
      <ComponentGroupRef Id="PublishedFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="IQ Genetics MC1R Haplotype Analysis" />
    </StandardDirectory>
  </Fragment>
  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuDir" Name="IQ Genetics MC1R Haplotype Analysis" />
    </StandardDirectory>
  </Fragment>
  <Fragment>
    <Component Id="StartMenuShortcut" Directory="StartMenuDir" Guid="D5774AA1-F836-4BF6-9205-DFC4F77D6751">
      <Shortcut Id="ApplicationStartMenuShortcut" Name="IQ Genetics MC1R Haplotype Analysis" Target="[INSTALLFOLDER]IQGenetics.MC1R.exe" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveStartMenuDir" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\IQGenetics\MC1R" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
