<Window x:Class="IQGenetics.MC1R.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:IQGenetics.MC1R.App.ViewModels"
        mc:Ignorable="d"
        Title="IQ Genetics — MC1R E-locus Haplotype Analysis" Height="760" Width="1450"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext><vm:MainViewModel/></Window.DataContext>
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="IQ Genetics — MC1R (E-locus) Haplotype Analysis" />
                <TextBlock Foreground="#666" Text="Gallus gallus • Sanger consensus • Ma et al. PNAS 2026 haplotype model"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Foreground="#666" VerticalAlignment="Bottom" Text="{Binding VersionString}" />
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="MC1R reference"/>
                    <DockPanel><TextBox Text="{Binding ReferencePath}" IsReadOnly="True" VerticalContentAlignment="Center"/><Button Content="Select..." Command="{Binding SelectReferenceCommand}" Margin="6,0,0,0"/></DockPanel>
                    <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="Sanger reads (.ab1) — load all reads for all birds in the batch"/>
                    <DockPanel><Button Content="Add Files..." Command="{Binding AddFilesCommand}" /><Button Content="Clear" Command="{Binding ClearFilesCommand}" Margin="6,0,0,0"/><TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#555" Text="{Binding FileCountLabel}" /></DockPanel>
                    <ListBox ItemsSource="{Binding InputFiles}" Height="95" BorderBrush="#CCC" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top"><Button Content="Run Analysis" Command="{Binding RunAnalysisCommand}" IsEnabled="{Binding CanRun}" Padding="16,8"/><Button Content="Export CSV" Command="{Binding ExportCsvCommand}" IsEnabled="{Binding CanExport}" Margin="0,8,0,0" Padding="16,8"/></StackPanel>
        </Grid>
        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal"><TextBlock FontWeight="SemiBold" Text="Sample-level results"/><TextBlock Margin="10,0,0,0" Foreground="#666" Text="{Binding StatusText}"/></StackPanel>
                    <TextBlock Margin="0,4,0,0" Foreground="#555" TextWrapping="Wrap" Text="E/E-compatible = both compatible haplotypes are strict E1/E2; E/ALT = one E1/E2 plus another MC1R haplotype; ALT/ALT = no strict E1/E2. AMBIGUOUS/INCOMPLETE/UNRESOLVED must not be forced into E/E."/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,10,0,0" IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sample" Binding="{Binding SampleName}" Width="135"/><DataGridTextColumn Header="Reads" Binding="{Binding TotalReads}" Width="55"/><DataGridTextColumn Header="Usable" Binding="{Binding UsableReads}" Width="55"/><DataGridTextColumn Header="QC" Binding="{Binding QcStatus}" Width="60"/><DataGridTextColumn Header="QC notes" Binding="{Binding QcNotes}" Width="220"/>
                        <DataGridTextColumn Header="c.212" Binding="{Binding Genotype212}" Width="65"/><DataGridTextColumn Header="c.274" Binding="{Binding Genotype274}" Width="65"/><DataGridTextColumn Header="c.376" Binding="{Binding Genotype376}" Width="65"/><DataGridTextColumn Header="c.398" Binding="{Binding Genotype398}" Width="65"/><DataGridTextColumn Header="c.409" Binding="{Binding Genotype409}" Width="65"/><DataGridTextColumn Header="c.427" Binding="{Binding Genotype427}" Width="65"/><DataGridTextColumn Header="c.637" Binding="{Binding Genotype637}" Width="65"/><DataGridTextColumn Header="c.644" Binding="{Binding Genotype644}" Width="65"/>
                        <DataGridTextColumn Header="Call status" Binding="{Binding CallStatus}" Width="95"/><DataGridTextColumn Header="Breeding category" Binding="{Binding BreedingCategory}" Width="125"/><DataGridTextColumn Header="Compatible diplotype(s)" Binding="{Binding CompatibleDiplotypes}" Width="240"/><DataGridTextColumn Header="Phenotype class(es)" Binding="{Binding CompatiblePhenotypes}" Width="220"/><DataGridTextColumn Header="Interpretation" Binding="{Binding Interpretation}" Width="360"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ProgressBar Width="420" Height="18" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" /><TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#555" Text="{Binding ProgressLabel}" /></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#888" Text="Offline • Windows x64 • No cloud upload" /></Grid>
    </Grid>
</Window>
